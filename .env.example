# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# Without these values VisionCut runs in local mode (no accounts, no cloud). See docs/supabase.md.

# ---- Supabase (PUBLIC values; safe in the desktop app, protected by Row Level Security) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- Sync API (server/). Only needed for cloud sync ----
# URL the desktop app uses to reach the API
VITE_API_URL=http://localhost:4000
# Postgres connection string (Supabase: Project Settings -> Database -> Connection string)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
SERVER_PORT=4000
# Extra browser origins allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:5173

# ---- Optional: use a specific FFmpeg instead of PATH / the bundled one ----
# VISIONCUT_FFMPEG=C:\ffmpeg\bin\ffmpeg.exe
# VISIONCUT_FFPROBE=C:\ffmpeg\bin\ffprobe.exe

# DO NOT add the Supabase service_role key here. Nothing in this project needs it.
