{
  "name": "visioncut-studio",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.119.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.70.0",
    "postcss": "^8.5.32",
    "prisma": "^6.19.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "supertest": "^7.3.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "description": "VisionCut Studio - professional desktop video editor (Electron, React, FFmpeg)",
  "main": "dist-electron/main.js",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "node scripts/build-electron.mjs && wait-on tcp:5173 && cross-env VISIONCUT_DEV=1 electron .",
    "build:electron": "node scripts/build-electron.mjs --prod",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "npm run build && node scripts/e2e-smoke.mjs",
    "server": "tsx server/index.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "postinstall": "prisma generate",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "dist:dir": "npm run build && electron-builder --win dir --x64"
  },
  "author": "VisionCut Studio contributors",
  "homepage": "https://github.com/your-org/visioncut-studio",
  "build": {
    "appId": "com.visioncut.studio",
    "productName": "VisionCut Studio",
    "copyright": "Copyright (c) 2026 VisionCut Studio contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "protocols": [
      {
        "name": "VisionCut",
        "schemes": [
          "visioncut"
        ]
      }
    ]
  }
}
